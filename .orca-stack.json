{
  "version": 1,
  "modo": "multiagente",
  "ramaBase": "main",
  "agentes": {
    "usa": ["claude", "agy", "codex", "codex-cc", "pi"],
    "preguntarAntes": ["codex-cc"]
  },
  "verificacion": {
    "suite": "npm test && npm run test:mods",
    "typecheck": "ninguno"
  },
  "riesgo": [
    "src/global.mjs",
    "src/remove.mjs",
    "src/backup.mjs",
    "src/marker.mjs",
    "src/gentle.mjs",
    "src/settings.mjs",
    "src/pi.mjs",
    "src/despacho.mjs",
    "mods/guardia-despacho/hooks/**",
    "mods/puente-gentle/hooks/**",
    "package.json"
  ],
  "merge": "main merges on its own when the merge condition holds",
  "despliegue": { "despues": false },
  "idioma": "English for code, comments, tests, commits and PRs; README, docs/ and CLI strings stay in Spanish until a separate decision",
  "setup": "completo"
}

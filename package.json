  "description": "Instala el stack de agentes: política de Orca, skills, wrappers de proveedores, Pi con Gentle Shell y mods de Claude Code.",
  "type": "module",
  "bin": {
    "orca-stack": "bin/orca-stack.mjs"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "mods",
    "shared",
    "LICENSE",
    "README.md"
  ],

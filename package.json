    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gagaismo/orca-stack.git"
  },
  "keywords": ["orca", "claude-code", "pi", "agents"]
